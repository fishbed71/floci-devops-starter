# 리눅스 컨테이너(EC2)에서 실행되는 파일은 항상 LF.
# Windows Git 의 autocrlf 로 CRLF 가 되면 user_data 가 "bad interpreter" 로 실패한다.
*.tftpl  text eol=lf
*.sh     text eol=lf
*.py     text eol=lf
Dockerfile text eol=lf
*.tf     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# PowerShell 스크립트는 CRLF (Windows PowerShell 5.1 호환)
*.ps1    text eol=crlf
